{
  "name": "frontend-wp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build --mode production",
    "build:analyze": "vite build --mode production && npm run analyze",
    "preview": "vite preview",
    "lint": "eslint .",
    "analyze": "npx vite-bundle-analyzer dist/stats.html",
    "clean": "rm -rf dist",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "size": "npm run build && ls -la dist/ && du -sh dist/*"
  },
  "dependencies": {
    "@woocommerce/woocommerce-rest-api": "^1.0.2",
    "axios": "^1.11.0",
    "buffer": "^6.0.3",
    "lucide-react": "^0.540.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.10",
    "vite-bundle-analyzer": "^0.18.0",
    "vite-plugin-pwa": "^0.21.1"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not dead",
    "not IE 11"
  ]
}
